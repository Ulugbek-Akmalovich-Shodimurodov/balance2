generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  TECHNICIAN
  VIEWER
}

enum AssetStatus {
  ACTIVE
  BROKEN
  DISPOSED
}

enum TransactionType {
  ASSIGN
  RETURN
}

enum MaintenanceStatus {
  NEW
  IN_PROGRESS
  REPAIRED
  REPLACED
  WAREHOUSED
}

enum DeliveryActStatus {
  DRAFT
  PENDING
  SIGNED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String?  @unique
  login     String?  @unique
  password  String
  phone     String?
  passportSeries String? @unique
  pinfl     String?  @unique
  imageUrl  String?
  role      Role     @default(VIEWER)
  departmentId Int?
  department Department? @relation(fields: [departmentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]
  transactions Transaction[] @relation("AssignedUserTransactions")
  previousTransactions Transaction[] @relation("PreviousUserTransactions")
  actions      Transaction[] @relation("ActorTransactions")
  auditLogs AuditLog[]
  receivedDeliveryActs DeliveryAct[] @relation("DeliveryActRecipient")
  createdDeliveryActs  DeliveryAct[] @relation("DeliveryActCreator")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int?
  parent    Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentHierarchy")
  assets    Asset[]
  users     User[]
  outgoingTransactions Transaction[] @relation("FromDepartmentTransactions")
  incomingTransactions Transaction[] @relation("ToDepartmentTransactions")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  assets    Asset[]
}

model Asset {
  id              Int         @id @default(autoincrement())
  name            String
  model           String      @default("")
  inventoryNumber String      @unique
  serialNumber    String?
  imageUrl        String?
  status          AssetStatus @default(ACTIVE)
  purchaseDate    DateTime?
  assetTypeId     Int?
  departmentId    Int?
  assignedUserId  Int?
  assetType       AssetType?  @relation(fields: [assetTypeId], references: [id])
  department      Department? @relation(fields: [departmentId], references: [id])
  assignedUser    User?       @relation(fields: [assignedUserId], references: [id])
  transactions    Transaction[]
  maintenanceLogs MaintenanceLog[]
  deliveryActs    DeliveryAct[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Transaction {
  id        Int             @id @default(autoincrement())
  assetId   Int
  userId    Int?
  fromUserId Int?
  actorId   Int
  fromDepartmentId Int?
  toDepartmentId Int?
  type      TransactionType
  note      String?
  asset     Asset @relation(fields: [assetId], references: [id])
  user      User? @relation("AssignedUserTransactions", fields: [userId], references: [id])
  fromUser  User? @relation("PreviousUserTransactions", fields: [fromUserId], references: [id])
  actor     User  @relation("ActorTransactions", fields: [actorId], references: [id])
  fromDepartment Department? @relation("FromDepartmentTransactions", fields: [fromDepartmentId], references: [id])
  toDepartment Department? @relation("ToDepartmentTransactions", fields: [toDepartmentId], references: [id])
  deliveryAct DeliveryAct?
  createdAt DateTime @default(now())
}

model DeliveryAct {
  id            Int               @id @default(autoincrement())
  number        String            @unique
  transactionId Int?              @unique
  assetId       Int
  recipientId   Int
  createdById   Int
  status        DeliveryActStatus @default(DRAFT)
  condition     String            @default("Yaxshi")
  equipment     String?
  note          String?
  documentText  String            @db.Text
  documentVersion Int             @default(1)
  snapshot      Json
  sentAt        DateTime?
  signedAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  transaction   Transaction?      @relation(fields: [transactionId], references: [id])
  asset         Asset             @relation(fields: [assetId], references: [id])
  recipient     User              @relation("DeliveryActRecipient", fields: [recipientId], references: [id])
  createdBy     User              @relation("DeliveryActCreator", fields: [createdById], references: [id])

  @@index([recipientId, assetId])
}

model MaintenanceLog {
  id          Int      @id @default(autoincrement())
  assetId     Int
  title       String
  description String?
  cost        Decimal? @db.Decimal(12,2)
  serviceDate DateTime @default(now())
  warrantyUntil DateTime?
  reportedUserId Int?
  reportedDepartmentId Int?
  status      MaintenanceStatus @default(NEW)
  resolutionNote String?
  resolvedAt  DateTime?
  asset       Asset @relation(fields: [assetId], references: [id])
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  entity    String
  entityId  Int?
  ipAddress String?
  metadata  Json?
  actor     User? @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())
}
